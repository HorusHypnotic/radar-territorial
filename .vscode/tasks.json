{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🔄 Pipeline Radar",
      "type": "shell",
      "command": "python",
      "args": ["python/pipeline.py"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "📊 Atualizar Dashboard",
      "type": "shell",
      "command": "python",
      "args": ["python/export/dashboard_data.py"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build"
    },
    {
      "label": "🧪 Testes",
      "type": "shell",
      "command": "python",
      "args": ["-m", "pytest", "tests", "-v"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test"
    },
    {
      "label": "Validar zoneamento GIS (LC 128/2022)",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "${workspaceFolder}/scripts/validate_zoning_gis.py",
        "--input", "${workspaceFolder}/data/output/zonas_oficiais_consolidado.geojson",
        "--report", "${workspaceFolder}/data/output/validacao_gis_lc128.json"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
